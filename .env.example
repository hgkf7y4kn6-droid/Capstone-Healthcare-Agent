# Copy to .env and fill in. Nothing here is required to run locally.
APP_ENV=development
CLINIC_NAME=Horsham Family Health
CLINIC_PHONE=(215) 555-0142

# Staff console sign-in (required when APP_ENV=production)
SESSION_SECRET=change-me-to-64-random-chars
# Shared demo code; works only when DEMO_MODE=true. Real staff use accounts: python -m scripts.create_staff_user
STAFF_ACCESS_CODE=change-me
STAFF_IDLE_MINUTES=15
CORS_ORIGINS=http://localhost:5173

# Patient assistant engine: auto | crew | concierge
ASSISTANT_ENGINE=auto   # deployed environments default to concierge
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_LLM_DEVICE=cpu

# Staff sign-in through Clerk (optional; replaces local accounts and the demo code when set).
# Public values only: the server verifies tokens with Clerk's public keys. Never put the Clerk secret key here.
# Claims needed on session tokens: role = {{user.public_metadata.role}} (admin|provider|front_desk), name = {{user.full_name}}.
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=
# CLERK_JWT_KEY=   # optional PEM public key to verify without fetching keys from Clerk

# Integrations (optional)
CALCOM_API_KEY=
TAVILY_API_KEY=
PORTAL_JWT_SECRET=
PORTAL_WEBHOOK_URL=
PORTAL_WEBHOOK_SECRET=
REDIS_URL=
AWS_SQS_QUEUE_URL=
