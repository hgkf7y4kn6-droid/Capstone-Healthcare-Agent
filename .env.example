# Copy to .env and fill in. Nothing here is required to run locally.
APP_ENV=development
CLINIC_NAME=Horsham Family Health
CLINIC_PHONE=(215) 555-0142

# Staff console sign-in (required when APP_ENV=production)
SESSION_SECRET=change-me-to-64-random-chars
STAFF_ACCESS_CODE=change-me
CORS_ORIGINS=http://localhost:5173

# Patient assistant engine: auto | crew | concierge
ASSISTANT_ENGINE=auto
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_LLM_DEVICE=cpu

# Integrations (optional)
CALCOM_API_KEY=
TAVILY_API_KEY=
PORTAL_JWT_SECRET=
PORTAL_WEBHOOK_URL=
PORTAL_WEBHOOK_SECRET=
REDIS_URL=
AWS_SQS_QUEUE_URL=
